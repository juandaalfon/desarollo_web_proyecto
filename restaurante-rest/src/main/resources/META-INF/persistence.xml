<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="restaurantePU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>model.Rol</class>
        <class>model.Usuario</class>
        <class>model.Mesa</class>
        <class>model.Categoria</class>
        <class>model.Producto</class>
        <class>model.Pedido</class>
        <class>model.DetallePedido</class>
        <class>model.HistorialEstado</class>
        <class>model.Factura</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <!-- Se pueden sobreescribir con las variables de entorno DB_URL, DB_USER y DB_PASSWORD (ver JPAUtil) -->
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/restaurante?createDatabaseIfNotExist=true&amp;serverTimezone=America/Bogota&amp;useSSL=false&amp;allowPublicKeyRetrieval=true"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="1234567890"/>

            <!-- Crea/actualiza las tablas a partir de las entidades -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
